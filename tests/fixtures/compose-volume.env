# Fixture: an install that adopts the compose-named volume (openclaw-style).

# Data volume to adopt, or to create on a fresh host. Existing deployments keep theirs:
#   legacy "podman run -v cf_data:/data" (toypark1234): cf_data
#   compose project woow_cloudflare_tunnel_webgui:       woow_cloudflare_tunnel_webgui_cf_data
CF_DATA_VOLUME=woow_cloudflare_tunnel_webgui_cf_data

# GUI/API port. The unit always binds it to 127.0.0.1.
UVICORN_PORT=18000

# cloudflared metrics/readiness endpoint (--metrics), probed by the healthcheck.
# It must stay on 127.0.0.1: with host networking, 0.0.0.0 would publish /config
# (the full ingress map) to the LAN. install.sh refuses anything else.
CF_METRICS_ADDR=127.0.0.1:20241

# Optional Basic-auth proxy (scripts/install.sh --with-auth).
# Listen address. Use 0.0.0.0:<port> only when the LAN must reach the GUI.
AUTH_LISTEN=127.0.0.1:8888
# htpasswd file, created with scripts/auth-passwd.sh USER. %h is your home directory.
AUTH_HTPASSWD=%h/.config/woow-cf-tunnel/htpasswd
